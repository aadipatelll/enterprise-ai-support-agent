# Copy to .env and adjust. .env is git-ignored.

# --- PostgreSQL (used by docker compose) ---
POSTGRES_USER=support
POSTGRES_PASSWORD=change-me
POSTGRES_DB=support_agent
POSTGRES_PORT=5432

# SQLAlchemy URL used by the backend and ingestion CLI (host = localhost when running outside Docker)
DATABASE_URL=postgresql+psycopg://support:change-me@localhost:5432/support_agent

# --- Models (any LangChain-supported provider; Ollama is free and local) ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Must match the embedding model's output size (nomic-embed-text = 768)
EMBEDDING_DIM=768
OLLAMA_BASE_URL=http://localhost:11434

# --- Ingestion ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
